# AI Network Threat Intelligence Platform Environment Variables

# App Environment
ENVIRONMENT=development
APP_NAME="AI Network Threat Intelligence Platform"

# Database Configuration (Host & Docker bridge compatible)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=threat_intel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/threat_intel
DATABASE_URL_DOCKER=postgresql://postgres:postgres@db:5432/threat_intel

# Security & JWT Configuration
# Note: For production, generate a secure random 32-byte key: `openssl rand -hex 32`
SECRET_KEY=dev_secret_key_change_in_production_9f8d7e6c5b4a3210
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Public Portfolio / Demo Rate Limiter (requests per minute per IP)
RATE_LIMIT_DEMO_PER_MINUTE=10
